## read/plain
sql:  SELECT * FROM "users"
args: []interface {}(nil)

## read/by-id
sql:  SELECT * FROM "users"
args: []interface {}(nil)

## read/where
sql:  SELECT * FROM "users" WHERE age > ? AND city = ?
args: []interface {}{21, "dhaka"}

## read/or
sql:  SELECT * FROM "users" WHERE age > ? OR vip = ?
args: []interface {}{21, true}

## read/in
sql:  SELECT * FROM "users" WHERE status IN (?, ?, ?)
args: []interface {}{"new", "active", "banned"}

## read/like
sql:  SELECT * FROM "users" WHERE name LIKE ? AND email NOT LIKE ?
args: []interface {}{"a%", "%spam%"}

## read/columns
sql:  SELECT id, name FROM "users"
args: []interface {}(nil)

## read/select-distinct
sql:  SELECT DISTINCT count(*) AS n, city FROM "users"
args: []interface {}(nil)

## read/order-limit-offset
sql:  SELECT * FROM "users" ORDER BY name ASC, age DESC LIMIT 10 OFFSET 20
args: []interface {}(nil)

## read/paginate
sql:  SELECT * FROM "users" LIMIT 25 OFFSET 50
args: []interface {}(nil)

## read/group-having
sql:  SELECT * FROM "users" GROUP BY city, role HAVING count(*) > ?
args: []interface {}{5}

## read/joins
sql:  SELECT * FROM "users" JOIN "orders" ON orders.user_id = users.id LEFT JOIN "carts" ON carts.user_id = users.id AND carts.active = ?
args: []interface {}{true}

## read/inner-right-join
sql:  SELECT * FROM "users" INNER JOIN "a" ON a.id = users.id RIGHT JOIN "b" ON b.id = users.id
args: []interface {}(nil)

## read/exists
sql:  SELECT * FROM "users" WHERE EXISTS (SELECT 1 FROM orders WHERE user_id = users.id AND total > ?)
args: []interface {}{100}

## read/not-exists
sql:  SELECT * FROM "users" WHERE NOT EXISTS (SELECT 1 FROM bans WHERE user_id = users.id AND reason = ?)
args: []interface {}{"spam"}

## read/cte
sql:  WITH recent AS (SELECT user_id FROM orders WHERE total > ?) SELECT * FROM "users" WHERE id IN (SELECT user_id FROM recent) AND city = ?
args: []interface {}{100, "dhaka"}

## read/two-ctes
sql:  WITH a AS (SELECT id FROM x WHERE v > ?), b AS (SELECT id FROM y WHERE v < ?) SELECT * FROM "users" WHERE city = ?
args: []interface {}{1, 2, "dhaka"}

## read/soft-delete-filter
sql:  SELECT * FROM "users" WHERE deleted_at IS NULL
args: []interface {}(nil)

## read/with-deleted
sql:  SELECT * FROM "users"
args: []interface {}(nil)

## count/plain
sql:  SELECT COUNT(*) FROM "users" WHERE age > ?
args: []interface {}{21}

