## delete/soft
sql:  UPDATE "users" SET deleted_at = CURRENT_TIMESTAMP WHERE deleted_at IS NULL
args: []interface {}(nil)

## delete/soft-where
sql:  UPDATE "users" SET deleted_at = CURRENT_TIMESTAMP WHERE ctid IN (SELECT ctid FROM "users" WHERE city = $1 AND deleted_at IS NULL LIMIT 1)
args: []interface {}{"dhaka"}

## delete/soft-many-where
