## insert/bulk
sql:  INSERT INTO "users" (name, email, score) VALUES ($1, $2, $3), ($4, $5, $6), ($7, $8, $9)
args: []interface {}{"alice", "alice@test.com", 1, "bob", "bob@test.com", 0, "carol", "", 3}

## update/partial
