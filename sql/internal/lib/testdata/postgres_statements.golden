sql:  UPDATE "users" SET name = $1, email = $2, score = $3 WHERE id IN (SELECT id FROM "users" WHERE city = $4 ORDER BY id LIMIT 1)
args: []interface {}{"alice", "alice@test.com", 7, "dhaka"}

## update/all-cols
sql:  UPDATE "users" SET id = $1, name = $2, email = $3, score = $4 WHERE 
